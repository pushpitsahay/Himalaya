# Spotify Developer App credentials
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET

# Must exactly match the Redirect URI configured in Spotify Developer Dashboard.
# For local development:
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/spotify/callback

# Your playlist is already configured below. Do not change unless needed.
SPOTIFY_PLAYLIST_ID=4IzjPmSdgQVTefQDbfSLXN

# Optional: after OAuth, you can put the refresh token here instead of using .spotify-token.json.
# SPOTIFY_REFRESH_TOKEN=
